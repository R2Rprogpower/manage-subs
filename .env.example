APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Kyiv

# Non-production idempotent Telegram fixtures; no bot token is stored.
TELEGRAM_TEST_SEED_ENABLED=true
TELEGRAM_TEST_OWNER_EMAIL=test@example.com
TELEGRAM_TEST_GROUP_CHAT_ID=-1001234567890
TELEGRAM_TEST_GROUP_USERNAME=demo_channel
TELEGRAM_TEST_GROUP_TITLE="Demo Telegram Group"
TELEGRAM_TEST_BOT_ID=987654321
TELEGRAM_TEST_BOT_USERNAME=demo_subscription_bot
TELEGRAM_TEST_BOT_NAME="Demo Subscription Bot"
TELEGRAM_TEST_BOT_EMAIL=telegram-bot@example.test

LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_BASE_URL=https://www.liqpay.ua

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=app

REDIS_HOST=redis

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_TOKEN_EXPIRATION=480
SANCTUM_TOKEN_PREFIX=manage_subs_

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
SCRAMBLE_PROTECT_DOCS=true

# Production deploy only. Generate the hash with: caddy hash-password
PGADMIN_BASIC_AUTH_USER=
PGADMIN_BASIC_AUTH_HASH=
